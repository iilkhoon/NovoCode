# build.nvidia.com API açarı (https://build.nvidia.com → Get API Key)
NVIDIA_API_KEY=nvapi-xxxxxxxx
# İstəyə bağlı: standart model (boş qalsa avtomatik seçilir)
NOVO_DEFAULT_MODEL=
# İstəyə bağlı: mövzuya uyğun real şəkillər üçün pulsuz Pexels açarı (https://www.pexels.com/api/)
PEXELS_API_KEY=
# Yayım: saytlar <ad>.<NOVO_ROOT_DOMAIN> ünvanında açılır (lokal: <ad>.localhost:3000)
# Serverdə: NOVO_ROOT_DOMAIN=novocode.app və DNS-də *.novocode.app → server IP
NOVO_ROOT_DOMAIN=
# Yayımlanan saytların saxlandığı qovluq (standart: .data/sites)
NOVO_SITES_DIR=
# İstəyə bağlı: hesablar və bulud sinxronizasiyası (supabase.com → Project settings → API)
# Cədvəl üçün supabase/schema.sql faylını SQL Editor-da işə salın; Auth → Providers-də Google/GitHub-ı açın
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Admin panel (/admin) şifrəsi — provayder açarları da bununla şifrələnir
NOVO_ADMIN_PASSWORD=

# Investor demo safety net. "fallback" = scripted reply only when the AI provider fails
# (recommended for live demos); "always" = never call the AI (offline rehearsal).
NOVO_DEMO=
